# ==============================================================================
# MAZOOQ FOODS - ENVIRONMENT VARIABLES
# Copy to `.env` for local use; set these in the Vercel / Render dashboard
# for production. NEVER commit the real `.env` file to Git.
# ==============================================================================

# --- Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys) ---
# Server-side only. Do NOT prefix with VITE_ (VITE_ vars get embedded in the browser bundle).
RAZORPAY_KEY_ID="rzp_test_replace_with_actual_key_id"
RAZORPAY_KEY_SECRET="replace_with_actual_key_secret"

# Create this in Razorpay Dashboard -> Settings -> Webhooks and enter the SAME value there.
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_secret"

# Optional (testing only): override the Razorpay API base URL.
# RAZORPAY_API_BASE="https://api.razorpay.com/v1"

# --- Email alerts (recommended) - https://resend.com (free: 3,000 emails/month) ---
# New orders, retailer applications and contact-form messages are emailed to you,
# and customers get an order confirmation email. Setup steps: DEPLOYMENT-GUIDE.md.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Sender - its domain (mazooq.com) must be verified in Resend -> Domains.
# EMAIL_FROM="Mazooq Foods <orders@mazooq.com>"
# Where alerts go (comma-separated for several people). Default: info@mazooq.com
# ORDER_ALERT_EMAIL="info@mazooq.com"

# --- Order notifications webhook (optional) ---
# If set, every paid / COD order is forwarded as JSON to this URL.
# Works with a Google Sheets Apps Script Web App, Zapier, Make, n8n, etc.
# ORDER_NOTIFY_WEBHOOK_URL="https://script.google.com/macros/s/XXXX/exec"

# --- Admin Panel ---
# Password for the admin panel (your-domain/admin). Use a strong password.
ADMIN_PASSWORD="replace_with_a_strong_password"

# Supabase (free) - admin data store (products, orders, leads).
# Create at supabase.com -> see ADMIN-SETUP-GUIDE.md for the full 10-minute walkthrough.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_with_service_role_key"

# Deploy Hook - site auto-updates (~1-2 min) after admin saves.
# Vercel: Project -> Settings -> Git -> Deploy Hooks -> create one -> paste URL.
# Render: Service -> Settings -> Deploy Hook -> paste URL.
# DEPLOY_HOOK_URL="https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy"

# Force local file store (development only - data saved in data/admin-store.json)
# ADMIN_STORE="file"

# --- Server ---
# Render sets PORT automatically. Local default is 8080.
# PORT=8080

# --- Gemini AI (only needed if you use the AI features from AI Studio) ---
# GEMINI_API_KEY="your-gemini-key"
# APP_URL="https://mazooq.com"

# --- Google Analytics 4 (optional) ---
# Create at analytics.google.com -> Admin -> Data Streams -> copy the G-XXXXXXXXXX ID here.
# VITE_GA4_ID="G-XXXXXXXXXX"
