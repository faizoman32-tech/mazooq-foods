{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/images/products/:file",
      "destination": "/photos/:file",
      "permanent": true
    },
    {
      "source": "/images/home/:file",
      "destination": "/photos/home-:file",
      "permanent": true
    },
    {
      "source": "/images/mazooq-logo.png",
      "destination": "/photos/mazooq-logo.png",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|admin|uploads/|images/|photos/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
